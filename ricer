#!/usr/bin/env bash
# ricer — AI-powered Linux rice and dotfile installer
# https://github.com/mrsreeindian/rice-farmer
set -euo pipefail

# ── Locate lib directory ──────────────────────────────────────────────────────
RICER_SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Installed path: ~/.local/lib/ricer; dev path: ./lib
if [ -d "${RICER_SELF}/../lib/ricer" ]; then
  LIB="${RICER_SELF}/../lib/ricer"
elif [ -d "${RICER_SELF}/lib" ]; then
  LIB="${RICER_SELF}/lib"
else
  echo "ERROR: Cannot find lib directory." >&2; exit 1
fi

# shellcheck source=lib/utils.sh
source "${LIB}/utils.sh"
# shellcheck source=lib/detect.sh
source "${LIB}/detect.sh"
# shellcheck source=lib/prerice.sh
source "${LIB}/prerice.sh"
# shellcheck source=lib/ai.sh
source "${LIB}/ai.sh"
# shellcheck source=lib/rules.sh
source "${LIB}/rules.sh"
# shellcheck source=lib/install.sh
source "${LIB}/install.sh"

VERSION="$(cat "${RICER_SELF}/.version" 2>/dev/null \
           || cat "${RICER_SELF}/../share/ricer/.version" 2>/dev/null \
           || echo "dev")"

# ── Flags / defaults ──────────────────────────────────────────────────────────
RICER_DRY_RUN=false
RICER_NO_BACKUP=false
RICER_OFFLINE=false
RICER_LOCAL=false
RICER_POLLIN_MODEL="openai"
RICER_CLEAN_ORPHANS=false
RICER_UPDATE_BETA=false

# ── Usage ─────────────────────────────────────────────────────────────────────
usage() {
  cat <<HELP

${BOLD}Rice Farmer${RESET} v${VERSION} — Install any Linux rice from a GitHub URL

${BOLD}USAGE${RESET}
  ricer detect                  Show detected system info
  ricer install <github-url>    Install a rice/dotfile repo
  ricer restore                 Restore the latest config backup
  ricer update [--beta]         Check for updates and pull latest release (or latest tag)
  ricer uninstall               Remove Rice Farmer from the system
  ricer version                 Print version and exit
  ricer help                    Show this help

${BOLD}FLAGS${RESET}
  --dry-run        Show the install plan without executing
  --local          Search for local models in Ollama / llama.cpp (>4B params)
  --no-backup      Skip config backup (dangerous!)
  --offline        Skip AI call, use built-in rule engine only
  --clean-orphans  Remove orphan/unused packages after installation
  --beta           Pull latest git tag instead of official release (update only)
  --model <name>   AI model to use (default: openai)
  --version        Print version and exit
  --help           Show this help

${BOLD}EXAMPLES${RESET}
  ricer install https://github.com/username/dotfiles
  ricer install https://github.com/user/hyprland-dots --local
  ricer install https://github.com/user/hyprland-dots --dry-run
  ricer install https://github.com/user/hyprland-dots --clean-orphans
  ricer restore
  ricer update
  ricer update --beta
  ricer uninstall

HELP
}

# ── Parse arguments ───────────────────────────────────────────────────────────
SUBCOMMAND=""
GITHUB_URL=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    detect|install|restore|update|uninstall) SUBCOMMAND="$1"; shift ;;
    version|--version|-v) echo "Rice Farmer v${VERSION}"; exit 0 ;;
    help|--help|-h)       usage; exit 0 ;;
    --dry-run)        RICER_DRY_RUN=true; shift ;;
    --local)          RICER_LOCAL=true; shift ;;
    --no-backup)      RICER_NO_BACKUP=true; shift ;;
    --offline)        RICER_OFFLINE=true; shift ;;
    --clean-orphans|--remove-orphans|--prune-orphans) RICER_CLEAN_ORPHANS=true; shift ;;
    --beta)           RICER_UPDATE_BETA=true; shift ;;
    --model)
      [ $# -ge 2 ] || { log_error "--model requires an argument"; exit 1; }
      RICER_POLLIN_MODEL="$2"; shift 2 ;;
    http*|git*|/*|./*|../*)
      GITHUB_URL="$1"; shift
      [ -z "$SUBCOMMAND" ] && SUBCOMMAND="install"
      ;;
    *)
      if [ "$SUBCOMMAND" = "install" ] && [ -z "$GITHUB_URL" ]; then
        GITHUB_URL="$1"; shift
      else
        log_error "Unknown argument: $1"
        usage; exit 1
      fi
      ;;
  esac
done

export RICER_NO_BACKUP RICER_OFFLINE RICER_LOCAL RICER_POLLIN_MODEL RICER_CLEAN_ORPHANS

# ── Dependency check ──────────────────────────────────────────────────────────
check_deps() {
  local missing=()
  for dep in curl git jq bash; do
    command -v "$dep" &>/dev/null || missing+=("$dep")
  done
  if [ ${#missing[@]} -gt 0 ]; then
    log_error "Missing required tools: ${missing[*]}"
    log_info  "Install them with your package manager, then re-run ricer."
    exit 1
  fi
}

# ── Subcommand: detect ────────────────────────────────────────────────────────
cmd_detect() {
  detect_system
  print_system_table
}

# ── Subcommand: install ───────────────────────────────────────────────────────
cmd_install() {
  [ -z "$GITHUB_URL" ] && { log_error "Please provide a GitHub URL."; usage; exit 1; }

  detect_system
  print_system_table

  # Validate URL looks like a GitHub repo
  if [[ ! "$GITHUB_URL" =~ ^https?://github\.com/[^/]+/[^/]+ ]]; then
    log_warn "URL doesn't look like a GitHub repo. Proceeding anyway..."
  fi

  # ── Clone repo ────────────────────────────────────────────────────────────
  local tmp_dir
  tmp_dir=$(mktemp -d /tmp/ricer-XXXXXXXXXX)
  export RICER_SERVER_PID_FILE="${tmp_dir}/server.pid"
  # Always clean up temp dir and any spawned local AI server on exit
  trap 'spinner_stop; [ -f "${tmp_dir}/server.pid" ] && kill "$(cat "${tmp_dir}/server.pid")" 2>/dev/null || true; [ -n "${RICER_SPAWNED_SERVER_PID:-}" ] && kill "${RICER_SPAWNED_SERVER_PID}" 2>/dev/null || true; [ -n "${tmp_dir:-}" ] && rm -rf "${tmp_dir}" && log_dim "Cleaned up ${tmp_dir}"' EXIT

  log_info "Cloning ${GITHUB_URL}..."
  if ! GIT_TERMINAL_PROMPT=0 \
       git clone --depth=1 --quiet "$GITHUB_URL" "$tmp_dir" 2>&1; then
    die "Failed to clone repository. Ensure the URL is correct and the repo is public."
  fi
  log_ok "Cloned to ${tmp_dir}"

  # ── Determine installation approach (File-First) ───────────────────────────
  log_info "Searching repository files for install script..."
  local install_script=""
  install_script=$(find_install_script "$tmp_dir" 2>/dev/null || true)

  local plan=""
  if [ -n "$install_script" ]; then
    log_ok "Found install script: ${install_script} (skipping AI initialization)"
    chmod +x "${tmp_dir}/${install_script#./}" 2>/dev/null || true

    # Prepend barebones WM step if system is barebones and target WM is identified
    local bb_step=""
    if [ "${RICER_IS_BAREBONES:-false}" = "true" ]; then
      bb_step=$(rules_barebones_step "$tmp_dir" 2>/dev/null || true)
    fi

    if [ -n "$bb_step" ] && [ "$bb_step" != "null" ]; then
      plan=$(jq -cn --argjson b "$bb_step" --arg s "$install_script" \
        '[$b, {"type":"run_cmd","args":[$s],"description":"Run repo install script"}]')
    else
      plan=$(jq -cn --arg s "$install_script" \
        '[{"type":"run_cmd","args":[$s],"description":"Run repo install script"}]')
    fi
  else
    log_info "No install script found. Initializing AI to plan filesystem changes..."
    if [ "$RICER_OFFLINE" = "false" ] || [ "$RICER_LOCAL" = "true" ]; then
      plan=$(get_ai_plan "$tmp_dir" "$GITHUB_URL") || true
    fi
    if [ -z "$plan" ] || [ "$plan" = "null" ] || [ "$plan" = "[]" ]; then
      log_info "Using built-in rule engine..."
      plan=$(rules_detect_plan "$tmp_dir") || plan="[]"
    fi
  fi

  # ── Pre-Rice & Conflict Analysis ──────────────────────────────────────────
  local pre_rice="${RICER_PRE_RICE:-none}"
  [ "$pre_rice" = "none" ] && pre_rice=$(detect_pre_rice 2>/dev/null || echo "none")

  local conflicts=()
  readarray -t conflicts < <(prerice_check_conflicts "$pre_rice" "$tmp_dir" 2>/dev/null || true)
  if [ ${#conflicts[@]} -gt 0 ]; then
    print_conflict_warning "$pre_rice" "${conflicts[@]}"
    local res_steps
    res_steps=$(prerice_get_resolutions "$pre_rice" "$tmp_dir" 2>/dev/null || echo "[]")
    if [ -n "$res_steps" ] && [ "$res_steps" != "[]" ]; then
      plan=$(jq -c --argjson r "$res_steps" '$r + .' <<< "$plan")
    fi
  fi

  # Auto-resolve missing dependencies for new rice on this base
  local -a missing_deps=()
  readarray -t missing_deps < <(prerice_get_dependencies "$pre_rice" "$tmp_dir" 2>/dev/null || true)
  if [ ${#missing_deps[@]} -gt 0 ]; then
    log_dim "Pre-rice: auto-detected missing dependencies: ${missing_deps[*]}"
    local dep_json
    dep_json=$(printf '%s\n' "${missing_deps[@]}" | jq -R . | jq -s .)
    local dep_step
    dep_step=$(jq -cn --argjson pkgs "$dep_json" \
      '{"type":"install_pkg","args":$pkgs,"description":"Auto-install dependencies required by rice"}')
    plan=$(jq -c --argjson d "$dep_step" '[$d] + .' <<< "$plan")
  fi

  # ── Show plan + confirm ───────────────────────────────────────────────────
  local n
  n=$(echo "$plan" | jq 'length' 2>/dev/null || echo 0)
  if [ "$n" -eq 0 ]; then
    log_warn "Could not determine install steps for this repo."
    log_info "You may need to install it manually. Check the repo README."
    exit 1
  fi

  print_plan "$plan"

  if [ "$RICER_DRY_RUN" = "true" ]; then
    if [ "$RICER_CLEAN_ORPHANS" = "true" ]; then
      clean_orphan_packages "true"
    fi
    log_info "Dry-run mode — no changes made."
    [ -f "${tmp_dir}/server.pid" ] && kill "$(cat "${tmp_dir}/server.pid")" 2>/dev/null || true
    [ -n "${RICER_SPAWNED_SERVER_PID:-}" ] && kill "${RICER_SPAWNED_SERVER_PID}" 2>/dev/null || true
    trap - EXIT   # disable cleanup trap (keep tmp for inspection)
    log_dim "Temp dir: $tmp_dir"
    exit 0
  fi

  [ "$RICER_NO_BACKUP" = "true" ] && log_warn "Backup disabled (--no-backup)."

  confirm "Apply this rice?" "n" || { log_info "Aborted."; exit 0; }

  # ── Execute ───────────────────────────────────────────────────────────────
  echo ""
  execute_steps "$plan" "$tmp_dir" "false"
  echo ""

  # ── Prune orphan packages if requested ────────────────────────────────────
  if [ "$RICER_CLEAN_ORPHANS" = "true" ]; then
    clean_orphan_packages "false"
    echo ""
  fi

  log_ok "${BOLD}Rice applied successfully!${RESET}"
  [ "${RICER_NO_BACKUP}" = "false" ] && [ -d "${RICER_BACKUP_DIR:-}" ] \
    && log_info "Backup: ${RICER_BACKUP_DIR}"
  log_info "You may need to restart your WM or log out for changes to take effect."
}

# ── Subcommand: restore ───────────────────────────────────────────────────────
cmd_restore() {
  restore_latest_backup
}

# ── Subcommand: update ────────────────────────────────────────────────────────
cmd_update() {
  local bin_dir="${HOME}/.local/bin"
  local lib_dir="${HOME}/.local/lib/ricer"
  local share_dir="${HOME}/.local/share/ricer"
  local channel="release"
  local remote_tag=""

  # ── Determine update channel ───────────────────────────────────────────────
  if [ "${RICER_UPDATE_BETA:-false}" = "true" ]; then
    channel="beta"
    log_info "Checking for latest tag from GitHub (beta channel)..."
    remote_tag=$(curl -fsSL --max-time 10 \
      -H "Accept: application/vnd.github.v3+json" \
      "https://api.github.com/repos/mrsreeindian/rice-farmer/tags" 2>/dev/null \
      | jq -r '.[0].name // empty' 2>/dev/null || true)

    if [ -z "$remote_tag" ] || [ "$remote_tag" = "null" ]; then
      die "Could not fetch tags from GitHub. Check your internet connection."
    fi
  else
    channel="release"
    log_info "Checking for latest release from GitHub (release channel)..."
    # Pull the latest official GitHub release only
    remote_tag=$(curl -fsSL --max-time 10 \
      -H "Accept: application/vnd.github.v3+json" \
      "https://api.github.com/repos/mrsreeindian/rice-farmer/releases/latest" 2>/dev/null \
      | jq -r '.tag_name // empty' 2>/dev/null || true)

    if [ -z "$remote_tag" ] || [ "$remote_tag" = "null" ]; then
      die "Could not find a published release on GitHub. Use 'ricer update --beta' to pull the latest tag."
    fi
  fi

  _ver_lte() {
    [ "$1" = "$2" ] || [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n 1)" = "$1" ]
  }

  # ── If running inside a git clone repository (developer mode) ───────────────
  if [ -d "${RICER_SELF}/.git" ]; then
    log_info "Git repository detected at ${RICER_SELF}."
    local current_target
    current_target=$(git -C "${RICER_SELF}" describe --tags --exact-match 2>/dev/null || echo "$VERSION")

    local clean_remote clean_current
    clean_remote=$(echo "$remote_tag" | sed -e 's/^v//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    clean_current=$(echo "$current_target" | sed -e 's/^v//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

    if [ "$clean_current" != "dev" ]; then
      if [ "$clean_remote" = "$clean_current" ]; then
        log_ok "Already on the latest ${channel} (${remote_tag})."
        return 0
      elif _ver_lte "$clean_remote" "$clean_current"; then
        if [ "$channel" = "release" ]; then
          log_ok "Current checkout (${current_target}) is up to date with latest release (${remote_tag})."
        else
          log_ok "Already on the latest tag (${current_target})."
        fi
        return 0
      fi
    fi

    log_info "Target ${channel}: ${remote_tag} (current: ${current_target})"
    confirm "Update git checkout to ${remote_tag}?" "y" || { log_info "Update cancelled."; return 0; }

    git -C "${RICER_SELF}" fetch origin --tags --quiet 2>/dev/null || git -C "${RICER_SELF}" fetch origin --quiet
    if git -C "${RICER_SELF}" checkout "$remote_tag" --quiet; then
      local new_ver
      new_ver=$(cat "${RICER_SELF}/.version" 2>/dev/null || echo "$remote_tag")
      log_ok "Updated successfully to v${new_ver} (${channel})!"
      return 0
    else
      die "Failed to checkout tag ${remote_tag}."
    fi
  fi

  # ── Installed mode (via curl installer) ────────────────────────────────────
  local remote_version
  remote_version=$(echo "$remote_tag" | sed -e 's/^v//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
  local current_version
  current_version=$(echo "$VERSION" | sed -e 's/^v//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

  if [ "$current_version" != "dev" ]; then
    if [ "$remote_version" = "$current_version" ]; then
      log_ok "Already on the latest ${channel} (v${current_version})."
      return 0
    elif _ver_lte "$remote_version" "$current_version"; then
      if [ "$channel" = "release" ]; then
        log_ok "Current version (v${current_version}) is up to date with latest release (v${remote_version})."
      else
        log_ok "Already on the latest tag (v${current_version})."
      fi
      return 0
    fi
  fi

  log_info "New ${channel} available: v${remote_version} (current: v${current_version})"
  confirm "Update now?" "y" || { log_info "Update cancelled."; return 0; }

  log_info "Downloading ${remote_tag}..."
  mkdir -p "$bin_dir" "$lib_dir" "$share_dir"

  local repo_raw="https://raw.githubusercontent.com/mrsreeindian/rice-farmer/${remote_tag}"

  local tmp_update_dir
  tmp_update_dir=$(mktemp -d /tmp/ricer-update-XXXXXX)
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp_update_dir'" RETURN

  # Download main script
  if ! curl -fsSL --max-time 30 "${repo_raw}/ricer" -o "${tmp_update_dir}/ricer"; then
    die "Failed to download ricer script from ${remote_tag}."
  fi
  chmod +x "${tmp_update_dir}/ricer"

  # Download libraries
  mkdir -p "${tmp_update_dir}/lib/profiles"
  for lib in utils detect prerice ai rules install; do
    if ! curl -fsSL --max-time 30 "${repo_raw}/lib/${lib}.sh" -o "${tmp_update_dir}/lib/${lib}.sh"; then
      die "Failed to download library lib/${lib}.sh from ${remote_tag}."
    fi
  done

  # Download pre-rice profiles
  for profile in omarchy cachyos garuda omakub caelestia generic; do
    curl -fsSL --max-time 30 "${repo_raw}/lib/profiles/${profile}.sh" -o "${tmp_update_dir}/lib/profiles/${profile}.sh" 2>/dev/null || true
  done

  # Verify syntax of all downloaded scripts before applying
  if ! bash -n "${tmp_update_dir}/ricer"; then
    die "Downloaded ricer failed syntax verification. Aborting update."
  fi
  for f in "${tmp_update_dir}/lib"/*.sh; do
    if ! bash -n "$f" 2>/dev/null; then
      die "Downloaded library $f failed syntax verification. Aborting update."
    fi
  done

  # Atomically install verified files
  mv -f "${tmp_update_dir}/ricer" "${bin_dir}/ricer"
  for lib in utils detect prerice ai rules install; do
    mv -f "${tmp_update_dir}/lib/${lib}.sh" "${lib_dir}/${lib}.sh"
  done
  for profile in omarchy cachyos garuda omakub caelestia generic; do
    [ -f "${tmp_update_dir}/lib/profiles/${profile}.sh" ] && mv -f "${tmp_update_dir}/lib/profiles/${profile}.sh" "${lib_dir}/profiles/${profile}.sh"
  done

  echo "$remote_version" > "${share_dir}/.version"
  log_ok "Updated successfully to Rice Farmer v${remote_version} (${channel})!"
  exit 0
}

# ── Subcommand: uninstall ─────────────────────────────────────────────────────
cmd_uninstall() {
  local bin_file="${HOME}/.local/bin/ricer"
  local lib_dir="${HOME}/.local/lib/ricer"
  local share_dir="${HOME}/.local/share/ricer"

  echo ""
  log_warn "This will uninstall Rice Farmer from your system."
  confirm "Are you sure you want to uninstall?" "n" || { log_info "Uninstall aborted."; return 0; }

  local removed=0
  if [ -f "$bin_file" ]; then
    rm -f "$bin_file" && log_ok "Removed binary: $bin_file"
    ((removed++))
  fi

  if [ -d "$lib_dir" ]; then
    rm -rf "$lib_dir" && log_ok "Removed libraries: $lib_dir"
    ((removed++))
  fi

  if [ -d "$share_dir" ]; then
    rm -rf "$share_dir" && log_ok "Removed share directory: $share_dir"
    ((removed++))
  fi

  if [ "$removed" -eq 0 ]; then
    log_info "No installed files found under ~/.local (you may be running from a dev repository)."
  else
    echo ""
    log_ok "Rice Farmer has been uninstalled."
    log_dim "Note: Config backups in ~/.config-backup-* were preserved."
    log_dim "If you want to remove PATH exports, check ~/.bashrc, ~/.zshrc, or ~/.profile."
  fi
}

# ── Main ──────────────────────────────────────────────────────────────────────
check_deps

case "$SUBCOMMAND" in
  detect)    cmd_detect ;;
  install)   cmd_install ;;
  restore)   cmd_restore ;;
  update)    cmd_update ;;
  uninstall) cmd_uninstall ;;
  version)   echo "Rice Farmer v${VERSION}"; exit 0 ;;
  help)      usage; exit 0 ;;
  "")        usage; exit 0 ;;
  *)         log_error "Unknown subcommand: $SUBCOMMAND"; usage; exit 1 ;;
esac
